<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>OpenPayments.Domain.Tests</RootNamespace>
    <AssemblyName>OpenPayments.Domain.Tests</AssemblyName>
    <IsTestProject>true</IsTestProject>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="FsCheck.Xunit" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/OpenPayments.Domain/OpenPayments.Domain.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Include="lifecycle-transitions.csv" CopyToOutputDirectory="PreserveNewest" />
