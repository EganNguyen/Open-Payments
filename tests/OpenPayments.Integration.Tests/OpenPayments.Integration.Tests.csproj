<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>OpenPayments.Integration.Tests</RootNamespace>
    <AssemblyName>OpenPayments.Integration.Tests</AssemblyName>
    <IsTestProject>true</IsTestProject>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="Npgsql" />
    <PackageReference Include="Testcontainers.PostgreSql" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/OpenPayments.Transitions/OpenPayments.Transitions.csproj" />
    <!-- Built, not referenced: the crash tests run the API and the mock PSP as real processes. -->
    <ProjectReference Include="../../src/OpenPayments.Api/OpenPayments.Api.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="../../tools/OpenPayments.MockPsp/OpenPayments.MockPsp.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>
</Project>
