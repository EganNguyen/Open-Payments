@inject OpenPayments.Console.Data.AttentionBadge AttentionBadge
@{
    var section = ViewData["Section"] as string ?? "payments";
    var badge = await AttentionBadge.CountAsync(Context);
    var badgeLabel = badge is { } n ? $"Needs attention, {n} to act on" : null;
}
<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
    <meta name="color-scheme" content="light dark">
    <title>@(ViewData["Title"] ?? "Console") · Open Payments</title>
    <link rel="stylesheet" href="~/css/ledger.css" asp-append-version="true">
    <script src="~/js/htmx-2.0.4.min.js" defer></script>
</head>
<body hx-boost="false">
<a class="skip" href="#main">Skip to content</a>
<div class="shell">
    <nav class="sidebar" aria-label="Main">
        <div class="brand">Open Payments</div>
        <a class="nav @(section == "attention" ? "current" : null)" href="/" aria-current="@(section == "attention" ? "page" : null)" aria-label="@badgeLabel">
            <svg class="icon" aria-hidden="true"><use href="/icons/ledger.svg#bell"></use></svg>Needs attention
            @if (badge is { } count)
            {
                <span class="badge" aria-hidden="true">@OpenPayments.Console.Presentation.AttentionPresentation.Badge(count)</span>
            }
        </a>
        <a class="nav @(section == "payments" ? "current" : null)" href="/Payments" aria-current="@(section == "payments" ? "page" : null)">
            <svg class="icon" aria-hidden="true"><use href="/icons/ledger.svg#list"></use></svg>Payments
        </a>
        <a class="nav @(section == "audit" ? "current" : null)" href="/Audit" aria-current="@(section == "audit" ? "page" : null)">
            <svg class="icon" aria-hidden="true"><use href="/icons/ledger.svg#log"></use></svg>Audit log
        </a>
        <a class="nav desktop-only @(section == "staff" ? "current" : null)" href="/Staff" aria-current="@(section == "staff" ? "page" : null)">
            <svg class="icon" aria-hidden="true"><use href="/icons/ledger.svg#people"></use></svg>Staff
        </a>
        <form method="post" action="/Account/SignOut" class="signout">
            @Html.AntiForgeryToken()
            <button type="submit" class="ghost">Sign out</button>
        </form>
    </nav>
    <main id="main" class="content">
        @RenderBody()
    </main>
</div>
<nav class="tabs" aria-label="Main">
    <a class="tab @(section == "attention" ? "current" : null)" href="/" aria-current="@(section == "attention" ? "page" : null)" aria-label="@(badgeLabel is null ? null : badgeLabel)">
        <span class="tab-icon"><svg class="icon" aria-hidden="true"><use href="/icons/ledger.svg#bell"></use></svg>@if (badge is { } tabCount)
        {<span class="tab-badge" aria-hidden="true">@OpenPayments.Console.Presentation.AttentionPresentation.Badge(tabCount)</span>}</span><span>Attention</span>
    </a>
    <a class="tab @(section == "payments" ? "current" : null)" href="/Payments" aria-current="@(section == "payments" ? "page" : null)">
        <svg class="icon" aria-hidden="true"><use href="/icons/ledger.svg#list"></use></svg><span>Payments</span>
    </a>
    <a class="tab @(section == "more" || section == "audit" ? "current" : null)" href="/More" aria-current="@(section == "more" ? "page" : null)">
        <svg class="icon" aria-hidden="true"><use href="/icons/ledger.svg#more"></use></svg><span>More</span>
    </a>
</nav>
</body>
</html>
