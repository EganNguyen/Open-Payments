        {
          "expr": "histogram_quantile(0.99, sum(rate(op_platform_overhead_seconds_bucket[5m])) by (le))",
          "legendFormat": "p99",
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
