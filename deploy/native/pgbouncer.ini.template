[databases]
openpayments = host=@RUN@ port=@PG_PORT@ dbname=openpayments

[pgbouncer]
listen_addr = 127.0.0.1
listen_port = @PORT@
unix_socket_dir = @RUN@
pidfile = @RUN@/pgbouncer@N@.pid
logfile = @LOG@/pgbouncer@N@.log
auth_type = scram-sha-256
auth_file = @REPO@/deploy/compose/pgbouncer/userlist.txt
admin_users = postgres

; Same pooling rules as the Compose stack
pool_mode = transaction
default_pool_size = 25
max_client_conn = 10000
max_prepared_statements = 200
query_wait_timeout = 5
server_login_retry = 1
log_connections = 0
log_disconnections = 0
